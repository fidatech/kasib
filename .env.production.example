# The .env of the server of kasib.af. Fill in the three marked values, then paste the
# whole text into the repository secret PRIME_ENV_FILE. Never commit the filled-in file.

APP_NAME="Kasib"
APP_ENV=production
# leave empty: the first deploy makes the key and it then stays on the server
APP_KEY=
APP_DEBUG=false
APP_URL=https://kasib.af
APP_TIMEZONE=Asia/Kabul

# kasib.af opens the public website and the administrator panel (/admin);
# every business gets its own address under it: name.kasib.af
CENTRAL_DOMAINS=kasib.af,www.kasib.af
TENANT_BASE_DOMAIN=kasib.af
TENANT_DATABASE_PREFIX=kasib_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# every business has its own database. On a plain server the MySQL user must be allowed to CREATE DATABASE.
# On cPanel the first deploy fills these three in and adds CPANEL_USER and CPANEL_TOKEN below, so the
# system asks the panel for the database and the subdomain of each new business.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_central_database
DB_USERNAME=CHANGE_ME_user
DB_PASSWORD=CHANGE_ME_password

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@kasib.af"
MAIL_FROM_NAME="${APP_NAME}"

# A copy of every nightly backup is sent to this FTP place outside the server (leave the host empty for none)
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=
BACKUP_FTP_PATH=kasib-backups
BACKUP_FTP_SSL=true
