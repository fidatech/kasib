APP_NAME="HesabBook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kabul

# Hosts of the system administrator panel, and the domain new businesses are created under
CENTRAL_DOMAINS=localhost,127.0.0.1,admin.hesabbook.test
TENANT_BASE_DOMAIN=hesabbook.test
TENANT_DATABASE_PREFIX=hb_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hesabbook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hesabbook@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# A copy of every nightly backup is sent to this FTP place outside the server (leave the host empty for none)
BACKUP_FTP_HOST=
BACKUP_FTP_PORT=21
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=
BACKUP_FTP_PATH=hesabbook-backups
BACKUP_FTP_SSL=true
